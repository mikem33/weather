/* ---------------------------- *\

    $Header

\*----------------------------- */

// Logo and, below it, the page title and subtitle, as in calculate-size-aspect-ratio.

.header
    padding-top rem(48)
    .heading
        margin-top rem(32)
        margin-bottom 0
        font-family $rubik
        font-weight 700
        text-transform none
        font-size rem(40)
        line-height 1
        +below(1023)
            font-size rem(28)
            line-height rem(32)
    // Like the design's section subtitles: Roboto Mono in Neon Blue.
    .subheading
        max-width rem(800)
        margin-top rem(16)
        margin-bottom 0
        font-family $roboto
        font-size "clamp(%s, 1.25vw, %s)" % (rem(18) rem(24))
        line-height 1.3
        text-transform none
        color $neonBlue
