/* ---------------------------- *\
    
    $Variables

\* ---------------------------- */

$fontSize           = 16
$lineHeight         = 22
$basetransition     = 250ms linear
$pseudotransition   = 250ms ease-in-out
$wrapperSize        = unit(1200/16, 'rem')

// $Colors (paint styles of the miguelmorera.com design)
$white              = #FFFFFF
$transparentWhite   = rgba($white, .6)
$oxfordBlue         = #01172F
$neonBlue           = #446DF6
$moonstone          = #08A4BD
$caribbeanCurrent   = #00635D
$chocolateCosmos    = #4C212A
$deepBlack          = #181726
$textBlack          = #2C2C2C
$lightestGrey       = #F5F5F5
$lightGrey          = #EFEFEF
$mediumGrey         = #A3A3A3
$grey               = #6C6C6C

// $Font $Families
$tanker             = 'Tanker', sans-serif
$rubik              = 'Rubik', sans-serif
$roboto             = 'Roboto Mono', monospace
$doto               = 'Doto', monospace
$cherryBomb         = 'Cherry Bomb One', sans-serif
